{
  "name": "octet-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "mascot": "node scripts/mascot.mjs",
    "export:check": "expo export --platform ios --platform android --output-dir /tmp/octet-export",
    "contract": "jest --config contract/jest.config.js --runInBand"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/flash-list": "2.0.2",
    "expo": "57.0.28",
    "expo-camera": "57.0.6",
    "expo-constants": "57.0.21",
    "expo-haptics": "57.0.3",
    "expo-linking": "57.0.12",
    "expo-local-authentication": "57.0.3",
    "expo-notifications": "57.0.22",
    "expo-router": "57.0.26",
    "expo-secure-store": "57.0.4",
    "expo-splash-screen": "57.0.10",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@bacons/apple-targets": "5.0.0",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "29.5.14",
    "@types/node": "26.6.5",
    "@types/react": "19.2.18",
    "@types/ws": "8.18.2",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.2",
    "jest": "29.7.0",
    "jest-expo": "57.0.6",
    "test-renderer": "1.3.1",
    "typescript": "6.0.3",
    "ws": "8.22.0"
  },
  "jest": {
    "preset": "jest-expo",
    "testTimeout": 15000,
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/contract/"
    ]
  },
  "expo": {
    "autolinking": {
      "exclude": [
        "@bacons/apple-targets"
      ]
    }
  }
}
