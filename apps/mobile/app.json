{
  "expo": {
    "name": "Octet",
    "slug": "octet",
    "scheme": "octet",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "dev.octet.mobile",
      "supportsTablet": false
    },
    "android": {
      "package": "dev.octet.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Octet uses the camera to scan the pairing code shown on your Mac.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ]
  }
}
